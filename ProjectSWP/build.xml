<?xml version="1.0" encoding="UTF-8"?>
<project name="ProjectSWP" default="build" basedir=".">
    
    <!-- === Properties === -->
    <property name="src.dir" location="src/java"/>
    <property name="build.dir" location="build"/>
    <property name="classes.dir" location="${build.dir}/web/WEB-INF/classes"/>
    <property name="lib.dir" location="lib"/>

    <!-- === Clean Task === -->
    <target name="clean">
        <echo>Cleaning build directory...</echo>
        <delete dir="${build.dir}" />
    </target>

    <!-- === Compile Java Classes === -->
    <target name="compile">
        <echo>Compiling Java source files...</echo>
        <mkdir dir="${classes.dir}" />
        <javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false" encoding="UTF-8">
            <classpath>
                <fileset dir="${lib.dir}">
                    <include name="**/*.jar"/>
                </fileset>
            </classpath>
        </javac>
    </target>

    <!-- === Default Build === -->
    <target name="build" depends="clean, compile">
        <echo>Build completed successfully.</echo>
    </target>

</project>
